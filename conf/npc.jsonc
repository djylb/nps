// npc 配置（JSONC，可写注释和尾逗号）。用法：npc -launch=@conf/npc.jsonc，或直接运行 npc
// 完整写法见 docs/reference/npc-config.md
{
  "profiles": {
    // 键是连接名
    "default": {
      // 在 nps 网页上创建客户端后得到的密钥
      "vkey": "123",
      // 混合端口，tls 为加密承载
      "paths": [{"url": "tls://127.0.0.1:8024"}],

      // 点对点本地访问：把本机端口映射到另一个 npc 提供的隧道
      // "access": [{"access": "sshkey", "target": "10.0.0.5:22", "local_type": "tcp", "local_port": 2000}],
    },
  },
}
